# LinkedIn Pipeline Environment Configuration
# Copy to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/data_lake

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=UTC

# Pipeline Schedule (cron format: minute hour day_of_month month day_of_week)
# Default: every 2 hours
PIPELINE_CRON="0 */2 * * *"

# Google Sheets Configuration
# Option 1: OAuth Client (for interactive auth)
GOOGLE_OAUTH_CLIENT_JSON=./.secrets/google_client.json
GOOGLE_OAUTH_TOKEN_JSON=./.secrets/google_token.json
# Optional fixed port for local OAuth redirect
GOOGLE_OAUTH_REDIRECT_PORT=8765

# Option 2: Service Account (for automated auth)
# GOOGLE_SERVICE_ACCOUNT_FILE=./.secrets/gcp-service-account.json

# Google Sheets URLs (comma-separated)
GOOGLE_SHEETS_URLS="https://docs.google.com/spreadsheets/d/SHEET_ID_1/edit#gid=GID_1,https://docs.google.com/spreadsheets/d/SHEET_ID_2/edit#gid=GID_2"

# Alternative: Use YAML config file
SHEETS_CONFIG=./config/sheets.yaml

# Data Filtering
MONTH_FILTER=aug

# LinkedIn Credentials (for scraping)
LINKEDIN_USERNAME=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Storage Configuration
STORAGE_BASE=./storage

# Legacy CSV/JSONL outputs (for backward compatibility)
OUTPUT_JSONL=./storage/linkedin_links.jsonl
OUTPUT_CSV=

# Scraping Configuration
# CONCURRENCY=4
# HEADED=false
# SCRAPER_TIMEOUT=30

# Development/Debug
# DEBUG=true
# LOG_LEVEL=INFO
